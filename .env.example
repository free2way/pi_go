# Never commit real values. Inject them from a secret manager in production.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Resolve the exact IDs with `pi --list-models deepseek` and
# `pi --list-models openai` after authentication.
PI_DEVELOPER_PROVIDER=deepseek
PI_DEVELOPER_MODEL=deepseek-flash
PI_REVIEWER_PROVIDER=openai-proxy
PI_REVIEWER_MODEL=gpt-5.6-sol
PI_DEVELOPER_CREDENTIAL_CONFIGURED=false
PI_REVIEWER_CREDENTIAL_CONFIGURED=false
PI_REAL_RUNS_ENABLED=false
PI_INTERNAL_TOKEN=

PI_WORKSPACE_ROOT=/workspace/runs
PI_MAX_REVIEW_ROUNDS=3
PI_RUN_TIMEOUT_SECONDS=1800
PI_MAX_CONCURRENT_RUNS=1

# Production uses the postgres service from deploy/docker/compose.yaml.
# Local development can point at any PostgreSQL instance.
PI_DATABASE_URL=postgresql://pigo:change-me@localhost:5432/pigo

# UI/API
PORT=3000
LOG_LEVEL=info

# A1: opt-in merge-request creation (see docs/10-closure-approval-automation.md).
PI_MERGE_REQUEST_URL=
PI_MERGE_REQUEST_TOKEN=
PI_MERGE_REQUEST_PROJECT=
PI_MERGE_REQUEST_TARGET_BRANCH=

# A2: optional post-merge deploy hook (http(s) URL, or `cmd: <command>`).
PI_POST_MERGE_DEPLOY_HOOK=

# A3: read-only deployment panel sources.
PI_WEB_VERSION=
PI_WORKER_VERSION=
PI_ROLLBACK_TAGS=
PI_DEPLOY_LOG=/app/pi-agent/backups/deploy.log
