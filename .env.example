# PiGO environment sample for the standard Compose deployment (deploy/docker/compose.yaml).
#
# Never commit real values. Inject them from a secret manager in production.
# Every variable the server (`web`) or worker (`worker`) reads is mirrored here;
# `npm run test:config` proves the compose file forwards each critical one.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Resolve the exact IDs with `pi --list-models deepseek` and
# `pi --list-models openai` after authentication.
PI_DEVELOPER_PROVIDER=deepseek
PI_DEVELOPER_MODEL=deepseek-flash
PI_REVIEWER_PROVIDER=openai-proxy
PI_REVIEWER_MODEL=gpt-5.6-sol
PI_DEVELOPER_CREDENTIAL_CONFIGURED=false
PI_REVIEWER_CREDENTIAL_CONFIGURED=false
PI_REAL_RUNS_ENABLED=false
PI_INTERNAL_TOKEN=

PI_WORKSPACE_ROOT=/workspace/runs
PI_MAX_REVIEW_ROUNDS=3
PI_RUN_TIMEOUT_SECONDS=1800
PI_MAX_CONCURRENT_RUNS=1

# Production uses the postgres service from deploy/docker/compose.yaml.
# Local development can point at any PostgreSQL instance.
PI_DATABASE_URL=postgresql://pigo:change-me@localhost:5432/pigo

# UI/API
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Model catalog and credential probing (AUD-08)
# ---------------------------------------------------------------------------
# Empty = builtin catalog merged with the role defaults above. A JSON array is a
# strict/verbatim allowlist (no defaults appended), e.g.
# PI_MODEL_CATALOG_JSON=[{"provider":"deepseek","model":"deepseek-flash","roles":["developer"]}]
PI_MODEL_CATALOG_JSON=
# `probe` (default) verifies stored keys against the provider; `off` lets the
# operator assert the key without a live probe.
PI_MODEL_PROBE_MODE=probe
# Base URL used for custom-provider probes (leave empty for the builtin table).
PI_PROVIDER_PROBE_BASE_URL=
# Upper bound for the startup credential probe pass, milliseconds.
PI_STARTUP_CREDENTIAL_PROBE_BUDGET_MS=10000

# ---------------------------------------------------------------------------
# A1/A2: closure and approval automation (see docs/10-closure-approval-automation.md)
# ---------------------------------------------------------------------------
# A1: opt-in merge-request creation (`PI_MERGE_REQUEST_URL` enables it).
PI_MERGE_REQUEST_URL=
PI_MERGE_REQUEST_TOKEN=
PI_MERGE_REQUEST_PROJECT=
PI_MERGE_REQUEST_TARGET_BRANCH=

# Explicit code-release hook (http(s) URL, or `cmd: <command>`). It is never
# invoked merely because code was merged. HTTP hooks require the token below;
# PiGO sends it as Bearer auth and uses it to sign the JSON body with HMAC-SHA256.
# Webhook mode also requires PI_PUBLIC_ORIGIN for the asynchronous callback URL.
PI_POST_MERGE_DEPLOY_HOOK=
PI_POST_MERGE_DEPLOY_TOKEN=

# ---------------------------------------------------------------------------
# A3: read-only deployment panel
# ---------------------------------------------------------------------------
# Versions shown by `/api/deployments` and the system status page; empty = unknown.
PI_WEB_VERSION=
PI_WORKER_VERSION=
# Comma-separated rollback image tags, e.g. `local/pigo-web:prev39,local/pigo-worker:prev35`.
PI_ROLLBACK_TAGS=
# Path *inside the web container* to the deployment log. The host directory is
# bind-mounted read-only at /app/pi-agent/backups (see PI_DEPLOY_LOG_HOST_DIR).
PI_DEPLOY_LOG=/app/pi-agent/backups/deploy.log
# Host directory bind-mounted read-only into web. Relative paths resolve against
# the compose file directory; the host project dir is /app/pi-agent.
PI_DEPLOY_LOG_HOST_DIR=./backups

# ---------------------------------------------------------------------------
# COST-002: run-level hard budgets. 0 = unlimited.
# ---------------------------------------------------------------------------
PI_RUN_MAX_TOKENS=0
PI_RUN_MAX_COST_USD=0
PI_RUN_MAX_MODEL_CALLS=0
# Web treats 0 as unlimited; the worker falls back to PI_RUN_TIMEOUT_SECONDS when unset.
PI_RUN_MAX_DURATION_SECONDS=
PI_RUN_CREATE_PER_MINUTE=20
PI_RUN_ACTIONS_PER_MINUTE=30
PI_ARTIFACT_MAX_DOWNLOAD_BYTES=5242880
PI_JOB_STALE_SECONDS=120

# ---------------------------------------------------------------------------
# Review convergence guard (worker). When a review round's NEW critical/high
# finding count has not decreased for two consecutive rounds, the worker stops
# before starting another repair round and escalates to needs_human. `off`
# disables the guard (default `on`).
# ---------------------------------------------------------------------------
PI_REVIEW_CONVERGENCE_GUARD=on

# ---------------------------------------------------------------------------
# REL-005/010: alerts and disk watermarks (worker)
# ---------------------------------------------------------------------------
PI_ALERT_WEBHOOK=
PI_ALERT_COOLDOWN_SECONDS=900
PI_MIN_FREE_DISK_MB=2048
# Empty = derived as max(32, PI_MIN_FREE_DISK_MB / 4).
PI_CRITICAL_FREE_DISK_MB=

# ---------------------------------------------------------------------------
# Provider retry / planner effort
# ---------------------------------------------------------------------------
PI_PROVIDER_ATTEMPTS=3
PI_PROVIDER_BACKOFF_MS=2000
PI_PROVIDER_MAX_BACKOFF_MS=30000
PI_PLANNER_THINKING=low
# Empty = code default (3 MiB).
PI_CALLBACK_MAX_BYTES=

# ---------------------------------------------------------------------------
# GAP-02: plugins are default-off; only allowlisted resources load (worker)
# ---------------------------------------------------------------------------
# Comma-separated allowlist entries (paths or `name@sha256:<hex>` pins).
PI_PLUGIN_ALLOWLIST=
# Comma-separated plugin requests to check against the allowlist.
PI_PLUGIN_REQUESTS=
# Require every allowlisted plugin to carry a sha256 pin.
PI_PLUGIN_REQUIRE_PIN=false
# Also consider plugins shipped inside the workspace repo (default false).
PI_PLUGIN_ALLOW_PROJECT=false
PI_PLUGIN_CONTAINER_DIR=/opt/pigo/plugins
# Sprint 2: SHA-256 pinned plugin registry (JSON). Empty = disabled (default),
# which keeps the flat allowlist above as the only source of plugins. Set to the
# container path of the read-only mount (default
# /app/pi-agent/pi-plugins.json) to enable it; registry entries win over the flat
# allowlist on a path conflict. A missing/invalid file fails worker startup
# loudly instead of silently disabling plugins.
PI_PLUGIN_REGISTRY=
# Host file bind-mounted read-only at /app/pi-agent/pi-plugins.json. Defaults to
# the shipped example (all-zero placeholder digests); point it at a reviewed
# registry with real digests before enabling PI_PLUGIN_REGISTRY.
PI_PLUGIN_REGISTRY_HOST_FILE=./pi-plugins.example.json

# ---------------------------------------------------------------------------
# Worker identity, locks and sandbox plumbing
# ---------------------------------------------------------------------------
# Empty = `worker-<pid>`.
PI_WORKER_ID=
PI_WORKSPACE_LOCK_STALE_SECONDS=300
PI_DOCKER_SOCKET=/var/run/docker.sock
PI_DOCKER_API_VERSION=v1.43
PI_GIT_EMPTY_CONFIG=/dev/null
# Comma-separated extra read-only binds / env passthroughs for sandbox containers.
PI_SANDBOX_EXTRA_BINDS=
PI_SANDBOX_EXTRA_ENV=

# ---------------------------------------------------------------------------
# Pipeline / workspaces
# ---------------------------------------------------------------------------
PI_PIPELINE_VERSION=pigo-pipeline-1
PI_WORKSPACES_ENABLED=true
