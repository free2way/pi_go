# PiGO demo / acceptance environment — EXAMPLE ONLY. Copy and edit:
#
#   cp deploy/docker/demo.env.example deploy/docker/demo.env
#   chmod 600 deploy/docker/demo.env
#
# deploy/docker/demo.env is git-ignored and must never be committed: it holds
# the shared PostgreSQL password, the vault key and the internal token. No real
# secret belongs in this example file.
#
# Bring the stack up with:
#
#   scripts/demo-env.sh up      # refuses to start unless the DB is /pigo_demo
#   scripts/demo-env.sh doctor  # PASS/FAIL checks with actionable hints
#
# The demo stack is NOT production. It shares the host's existing PostgreSQL
# container (compose project `pi-agent`) and the host Docker socket, and it
# reads one credential vault file that must already exist on the host.

# ---------------------------------------------------------------------------
# Identity / version reported by web and worker. A single value keeps the
# deployment panel and `doctor` version checks consistent; `doctor` FAILs when
# the resolved web/worker versions differ.
# ---------------------------------------------------------------------------
PIGO_DEMO_VERSION=demo-0.27.1

# ---------------------------------------------------------------------------
# Secrets (intentionally empty; never commit real values)
# ---------------------------------------------------------------------------
# Password of the `pigo` role on the EXISTING production PostgreSQL container.
# The demo reuses that container but connects to the isolated `pigo_demo` DB.
PIGO_POSTGRES_PASSWORD=
# Base64-encoded 32-byte vault key. It must be the SAME key that encrypted the
# credential file below, otherwise the vault cannot decrypt provider keys.
PI_VAULT_SECRET=
# Shared secret between demo-web and demo-worker. `doctor` asserts web == worker
# and prints only a length + hash prefix.
PI_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# Host paths (absolute). These are bind mounts, not named volumes.
# ---------------------------------------------------------------------------
# Directory that already contains the encrypted credential vault
# `credentials.v1.json` (mode 600, writable by uid 1000). `up` and the
# `demo-preflight` service fail closed when it is missing/unreadable.
# Recommended: extract it from the production web container, e.g.
#   mkdir -p /app/pi-agent/demo-data
#   docker compose -f /app/pi-agent/compose.yaml cp web:/app/data/credentials.v1.json /app/pi-agent/demo-data/
#   chown -R 1000:1000 /app/pi-agent/demo-data
PIGO_DEMO_DATA_DIR=/app/pi-agent/demo-data
# Workspaces root: projects/<name>/ and runs/<run-id>/ live here. Keep it
# separate from production so demo worktrees cannot collide with real runs.
PIGO_DEMO_WORKSPACE_ROOT=/app/pi-agent/demo-workspace
# HOST path of the provider/model definition used by the worker and its sandbox
# containers (see deploy/docker/export-models.sh). The same file is mounted
# read-only into the worker at /home/node/.pi/agent/models.json.
PIGO_DEMO_MODELS_FILE=/app/pi-agent/pi-models.json

# ---------------------------------------------------------------------------
# Exposure (set the bind address privately for each deployment)
# ---------------------------------------------------------------------------
PIGO_DEMO_WEB_BIND_ADDRESS=
PIGO_DEMO_WEB_PORT=3101
# Loopback-only listener for `status`/`seed`/`doctor` and Playwright.
PIGO_DEMO_WEB_LOOPBACK_ADDRESS=127.0.0.1
PIGO_DEMO_WEB_LOOPBACK_PORT=3102

# ---------------------------------------------------------------------------
# Docker / sandbox plumbing
# ---------------------------------------------------------------------------
# gid of /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
PIGO_DEMO_DOCKER_GID=983
# Network the worker adds to its per-call sandbox containers (the shared
# production network, so sandboxes can reach the demo services if needed).
PIGO_DEMO_SANDBOX_NETWORK=pi-agent-network
PIGO_DEMO_WORKER_ID=pigo-demo-worker
# Must already exist: docker build -f deploy/docker/Dockerfile.sandbox -t local/pigo-sandbox:0.1.0 .
PI_SANDBOX_IMAGE=local/pigo-sandbox:0.1.0

# ---------------------------------------------------------------------------
# Seed / doctor identity (development auth header `x-pigo-dev-email`).
# Stories seeded by `scripts/demo-env.sh seed` are owned by this identity.
# ---------------------------------------------------------------------------
PIGO_DEMO_DEV_EMAIL=developer@localhost

# ---------------------------------------------------------------------------
# Optional model overrides (defaults match production role defaults)
# ---------------------------------------------------------------------------
# PI_DEVELOPER_PROVIDER=deepseek
# PI_DEVELOPER_MODEL=deepseek-flash
# PI_REVIEWER_PROVIDER=openai-proxy
# PI_REVIEWER_MODEL=gpt-5.6-sol
