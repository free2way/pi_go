FROM node:22.23.3-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
RUN npm run build

FROM node:22.23.3-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
RUN install -d -o node -g node /app/data
# No git here (deliberate). Every workspace operation — create/validate/refresh
# and clone — is forwarded from the web process to the worker over PI_WORKER_URL
# (src/server/workspaces.ts calls POST /workspaces/{verify,clone,create}); every
# `git` subprocess runs in the worker (src/worker/index.ts). The only subprocess
# the web process can start is the operator-configured post-merge release command
# (src/server/release-execution.ts, /bin/sh -c), which is not workspace I/O.
# The earlier "workspace invalid" symptom came from the demo compose workspace
# path/ownership (a nested bind), not from a missing web-side git. Keep git in
# Dockerfile.worker only.

USER node
EXPOSE 3100
CMD ["node", "dist/server/index.js"]

