# Copy to the executor install directory as .env and chmod 600.
# Generate with: openssl rand -hex 32. Use the same value in PiGO release settings.
PIGO_EXECUTOR_TOKEN=
# Independent secret used only between the network-facing executor and the
# internal release gateway. Generate a different value with openssl rand -hex 32.
PIGO_RELEASE_GATEWAY_TOKEN=

# Use a dedicated rootless daemon socket for the release execution plane.
PIGO_RELEASE_DOCKER_SOCKET=/run/user/1000/docker.sock
# Release Gateway verifies Docker's explicit rootless option by default and
# fails before listening on a rootful engine. Only local compatibility may set 0.
PIGO_RELEASE_REQUIRE_ROOTLESS=1
# Docker socket group id on the host: stat -c %g "$PIGO_RELEASE_DOCKER_SOCKET"
DOCKER_GID=1000

# Host-specific values are deliberately placeholders. Never commit the real .env.
# Directory that directly contains registered repository root paths.
PIGO_HOST_WORKSPACE_ROOT=/srv/pigo/workspace/projects
PIGO_EXECUTOR_APP_PATH=apps/order-status-app
PIGO_EXECUTOR_CALLBACK_ORIGIN=https://pigo.example.com
PIGO_EXECUTOR_CALLBACK_INTERNAL_ORIGIN=http://web:3100
PIGO_EXECUTOR_IMAGE_REPOSITORY=local/order-status-app
# Dedicated internal bridge used only for executor-to-deployment smoke traffic.
PIGO_EXECUTOR_TARGET_NETWORK=pigo-release-targets
PIGO_EXECUTOR_STAGING_URL=http://host.docker.internal:18080
PIGO_EXECUTOR_PRODUCTION_URL=http://host.docker.internal:18081
# Optional browser-facing addresses returned to PiGO after a successful deploy.
# Leave blank until a reverse proxy or tunnel exposes the target safely.
PIGO_EXECUTOR_STAGING_PUBLIC_URL=
PIGO_EXECUTOR_PRODUCTION_PUBLIC_URL=
PIGO_EXECUTOR_STAGING_PORT=18080
PIGO_EXECUTOR_PRODUCTION_PORT=18081
PIGO_DOCKER_NETWORK=pi-agent-network
