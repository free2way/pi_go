{
  "name": "pigo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@xyflow/react": "12.9.3",
    "fastify": "5.6.1",
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.3"
  }
}

