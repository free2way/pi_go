{
  "name": "pigo-web",
  "version": "0.27.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsup src/server/index.ts src/server/run-store-pg.ts src/server/db.ts --format esm --platform node --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:executor": "node --test deploy/executor/server.test.mjs deploy/executor/release-gateway.test.mjs",
    "test:decision": "vitest run src/server/decision-engine src/server/decision-routes.test.ts src/worker/decision-triage.test.ts src/worker/decision-integration.test.ts",
    "test:decision:e2e": "playwright test tests/e2e/decision-engine.spec.ts --project=chromium",
    "test:jev:live": "vitest run --config vitest.live.config.ts",
    "test:decision:perf": "vitest run --config vitest.perf.config.ts",
    "report:sessions": "node scripts/session-reuse-report.mjs",
    "report:at-coverage": "node scripts/report-at-coverage.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:config": "node scripts/compose-config-coverage.mjs",
    "validate:compose": "node deploy/docker/validate-compose.mjs",
    "plan:oci-deployment": "node scripts/oci-deployment-env.mjs",
    "gate:oci-promotion": "node scripts/oci-promotion-gate.mjs",
    "audit:containers": "node scripts/container-security-audit.mjs",
    "check:clerk": "node scripts/clerk-config-check.mjs",
    "test:pg:concurrency": "node scripts/pg-concurrency-check.mjs",
    "lint": "eslint .",
    "e2e:browser": "playwright test",
    "gate:release": "node scripts/release-gate.mjs",
    "gate:acceptance": "node scripts/acceptance-gate.mjs",
    "gate:browser-report": "node scripts/browser-smoke-verdict.mjs",
    "scan:secrets": "bash scripts/secret-scan.sh",
    "scan:repository-policy": "node scripts/repository-policy-scan.mjs",
    "drill:providers": "node scripts/provider-drill.mjs",
    "drill:archive": "bash scripts/drill-archive.sh",
    "drill:rollback": "bash scripts/rollback-drill.sh"
  },
  "dependencies": {
    "@clerk/fastify": "3.1.20",
    "@clerk/localizations": "4.23.0",
    "@clerk/react": "6.17.8",
    "@fastify/compress": "^9.2.1",
    "@fastify/static": "^10.1.5",
    "@xyflow/react": "^12.12.0",
    "fastify": "^5.12.5",
    "jose": "^6.1.0",
    "lucide-react": "0.545.0",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pg-mem": "^3.0.14",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
